# Visual Studio / .NET
.vs/
bin/
obj/
*.user
*.suo

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# React
dist/
build/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Environment variables
.env
.env.*
!.env.example

# Secrets — connection strings belong in `dotnet user-secrets`, never in the repo
appsettings.*.local.json
secrets.json

# IDE
# Share the workspace settings (they fix C# Dev Kit solution discovery);
# ignore everything else VS Code writes. Note the /* rather than / — git cannot
# re-include a file whose parent directory is itself excluded.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log