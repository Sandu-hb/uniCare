# Copy this file to `.env` and fill in your own values. `.env` is gitignored.
#
# DATABASE_URL accepts the connection string exactly as Neon shows it in the
# console (Dashboard -> Connect). The API converts the URI to the key/value form
# Npgsql expects at startup, so paste it verbatim.

DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<database>?sslmode=require

# JWT_SECRET signs and validates bearer tokens — generate a long random value
# (e.g. `openssl rand -base64 48`) and never reuse it across environments.
# JWT_ISSUER/JWT_AUDIENCE just need to match between token issuance and
# validation; they default to UniCare/UniCareClient if unset.
JWT_SECRET=<a long random string>
JWT_ISSUER=UniCare
JWT_AUDIENCE=UniCareClient

# Access token lifetime. Keep this short (15 min) — refresh tokens handle
# silent renewal. A shorter window limits the damage if a token is stolen.
JWT_EXPIRY_MINUTES=15
